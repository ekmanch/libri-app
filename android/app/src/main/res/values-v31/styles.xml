<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw the system splash themselves: the Libri
         mark in the middle and the name near the bottom (F1), on the app's
         light background. The dark counterpart is in values-night-v31. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
    </style>
</resources>
