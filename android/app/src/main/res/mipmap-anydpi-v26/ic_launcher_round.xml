<?xml version="1.0" encoding="utf-8"?>
<!-- The Libri launcher icon (sources in assets/logos/libri): the peach and
     paper halves behind the play triangle and the three lines, plus the
     monochrome layer that Android 13 and launchers such as Niagara tint
     for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
