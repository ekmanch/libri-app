<?xml version="1.0" encoding="utf-8"?>
<!-- The window behind the Flutter engine while it starts, and the whole
     splash before Android 12: the Libri mark in the middle and the name
     near the bottom (F1), on the window's own background color. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />
    <item
        android:drawable="@drawable/splash_icon"
        android:gravity="center" />
    <item
        android:drawable="@drawable/splash_branding"
        android:gravity="bottom|center_horizontal"
        android:bottom="36dp" />
</layer-list>
